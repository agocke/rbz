# Cross-compilation toolchains for dotnet/runtime Bazel build.
# Registers an aarch64-linux-gnu toolchain for building linux-arm64 targets
# from a linux-x64 host.

load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":linux_arm64_cc_toolchain_config.bzl", "linux_arm64_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# Toolchain config rule instance.
# Default attrs target the dotnet cross-build container
# (mcr.microsoft.com/dotnet-buildtools/prereqs:azurelinux-3.0-net11.0-cross-arm64)
# with rootfs at /crossrootfs/arm64 and clang at /usr/local/bin.
linux_arm64_cc_toolchain_config(
    name = "linux_arm64_toolchain_config",
    clang_resource_dirs = [
        "/usr/local/lib/clang/22/include",
    ],
)

# File groups for the cross-compiler (system-installed)
filegroup(name = "empty")

cc_toolchain(
    name = "linux_arm64_cc_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":linux_arm64_toolchain_config",
)

toolchain(
    name = "linux_arm64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":linux_arm64_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Test-execution toolchain for cross-compilation: Bazel's default test
# toolchain requires an execution platform matching the target, which blocks
# `bazel build` of test targets during cross-compilation.  This toolchain
# tells Bazel that arm64 test execution is handled externally (via Helix),
# so it's safe to build arm64 test targets on an x64 host.
toolchain(
    name = "linux_arm64_helix_test_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)
