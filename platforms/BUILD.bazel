# Custom platform definitions for cross-compilation.
# The osx-arm64 target is the only supported macOS platform (see .bazelrc
# header), but CI runners may be Intel x64, so we need an explicit platform
# to force arm64 target selection in select() rules and toolchain resolution.

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)
