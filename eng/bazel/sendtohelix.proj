<!-- Sends Bazel-built test payloads to Helix for remote execution.
     Used by the linux-arm64 CI leg in .github/workflows/bazel.yml.

     Usage:
       dotnet msbuild eng/bazel/sendtohelix.proj \
         /p:HelixTargetQueues="..." \
         /p:TesthostPayload=path/to/testhost.tar.gz \
         /p:TestPayloadDir=path/to/test-payloads \
         /p:Creator=github-user
-->
<Project Sdk="Microsoft.DotNet.Helix.Sdk" DefaultTargets="Test">

  <PropertyGroup>
    <!-- Helix metadata -->
    <HelixSource>pr/agocke/rbz/bazel/</HelixSource>
    <HelixType>test/bazel/arm64/</HelixType>
    <HelixBuild Condition="'$(HelixBuild)' == ''">$(GITHUB_RUN_ID)</HelixBuild>
    <Creator Condition="'$(Creator)' == ''">$(GITHUB_ACTOR)</Creator>

    <!-- Queue selection — callers must provide this -->
    <HelixTargetQueues Condition="'$(HelixTargetQueues)' == ''">(Ubuntu.2204.ArmArch.Open)AzureLinux.3.Arm64.Open@mcr.microsoft.com/dotnet-buildtools/prereqs:ubuntu-22.04-helix-arm64v8</HelixTargetQueues>

    <!-- Anonymous submission (no access token needed for .Open queues) -->
    <HelixAccessToken />

    <!-- Payload paths — set by the workflow -->
    <TesthostPayload Condition="'$(TesthostPayload)' == ''">$(MSBuildThisFileDirectory)../../artifacts/helix/testhost</TesthostPayload>
    <TestPayloadDir Condition="'$(TestPayloadDir)' == ''">$(MSBuildThisFileDirectory)../../artifacts/helix/tests</TestPayloadDir>

    <!-- Timeout per work item -->
    <WorkItemTimeout>00:15:00</WorkItemTimeout>
  </PropertyGroup>

  <!-- Correlation payload: the arm64 testhost (dotnet + shared framework + native libs) -->
  <ItemGroup>
    <HelixCorrelationPayload Include="$(TesthostPayload)">
      <PayloadDirectory>%(Identity)</PayloadDirectory>
    </HelixCorrelationPayload>
  </ItemGroup>

  <Target Name="BuildHelixWorkItems" BeforeTargets="CoreTest">
    <!-- Discover test payload directories -->
    <ItemGroup>
      <_TestPayloadDir Include="$([System.IO.Directory]::GetDirectories('$(TestPayloadDir)'))" />
    </ItemGroup>

    <!-- Create work items: use directory name as work item name -->
    <ItemGroup>
      <HelixWorkItem Include="%(_TestPayloadDir.Filename)%(_TestPayloadDir.Extension)">
        <PayloadDirectory>%(_TestPayloadDir.FullPath)</PayloadDirectory>
        <Command>chmod +x run.sh &amp;&amp; ./run.sh</Command>
        <Timeout>$(WorkItemTimeout)</Timeout>
      </HelixWorkItem>
    </ItemGroup>
  </Target>

</Project>
